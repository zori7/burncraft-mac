# Single source of truth for app naming. Edit here, then run scripts/build-app.sh
# (it regenerates Sources/BurnCore/AppConfig.swift and the Info.plist).
APP_NAME="ArchiveBurner"
ORG_ID="tapsiom"
BUNDLE_ID="${BUNDLE_ID:-com.${ORG_ID}.$(echo "$APP_NAME" | tr '[:upper:]' '[:lower:]')}"
VERSION="0.1.0"
MIN_MACOS="14.0"
